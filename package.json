{
  "name": "agent-switchyard",
  "version": "0.0.0",
  "description": "A local-first, quota-aware scheduler for subscription-backed coding agents.",
  "type": "module",
  "private": true,
  "bin": {
    "switchyard": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build --silent && node --enable-source-maps dist/cli.js",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.18"
  },
  "license": "Apache-2.0"
}
